# App
APP_NAME=Industrial Vision API
# APP_VERSION defaults to the version in app/config.py; set it only to override
# APP_VERSION=
APP_ENV=development
DEBUG=false
# Required: generate a unique random value with at least 32 characters.
SECRET_KEY=
# Required on first setup only: generate a random password of at least 20 characters.
ADMIN_INITIAL_PASSWORD=

# Server (WORKERS must stay 1: runtime state lives in one process)
HOST=0.0.0.0
PORT=8000
WORKERS=1

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/factory_data.db
# SQLite journal: WAL lets dashboards read while events are written (DELETE = the
# old rollback journal). WAL needs the database on a local disk or Docker volume,
# not a network share.
SQLITE_JOURNAL_MODE=WAL
# NORMAL: a server crash loses nothing committed; a power cut can lose the last
# commits but never corrupts the file. FULL: no loss on power cuts, slower writes.
SQLITE_SYNCHRONOUS=NORMAL
# Milliseconds a write waits for another one to finish before failing
SQLITE_BUSY_TIMEOUT_MS=5000

# Auth / JWT
JWT_ALGORITHM=HS256
# Login lifetime; the code default is 2880 (2 days) when this is unset
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
# Not read by the server (the login lifetime is ACCESS_TOKEN_EXPIRE_MINUTES)
# SESSION_DURATION_DAYS=2

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# MQTT
MQTT_BROKER_HOST=
MQTT_BROKER_PORT=8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS_ENABLED=true
# Path to the broker's CA certificate; empty = system CA store
MQTT_CA_CERT_PATH=

# Bundled MQTT broker (optional): `docker compose --profile broker up -d`
# starts a Mosquitto beside the server. Every client signs in with this login;
# the broker does not start while BROKER_PASSWORD is empty. Under Connections,
# add an MQTT channel with host `mqtt`, port 1883 and this login.
BROKER_USERNAME=vision
BROKER_PASSWORD=
# Where other devices (Ignition, PLC gateways) reach it on this machine.
BROKER_PORT=1883
BROKER_BIND_ADDRESS=0.0.0.0

# Modbus
MODBUS_HOST=192.168.1.100
MODBUS_PORT=502
MODBUS_TIMEOUT=3

# Model / Inference
MODEL_STORE_PATH=./model_store
# cpu, or auto (GPU through DirectML/CUDA when available, else CPU). In Docker,
# docker/detect_hardware.py sets it for the container (docker-compose.override.yml).
INFERENCE_DEVICE=cpu
# CPU threads for ONNX Runtime; 0 = auto (2 with a GPU, about one per core on CPU)
INFERENCE_THREADS=0
# Not read by the server: each model uses its own confidence and NMS thresholds
INFERENCE_CONFIDENCE=0.5
# INFERENCE_NMS_THRESHOLD=0.45
# Detect API calls use the model one at a time and, while cameras are connected,
# at most this share of its time (live counting keeps the rest); 1 = no limit
API_INFERENCE_MAX_SHARE=0.25
# Detect calls allowed to wait for the model before new ones get HTTP 429; 0 = no limit
API_INFERENCE_QUEUE_LIMIT=8

# Upload size limits in bytes (model files 512 MB, images 10 MB)
MAX_MODEL_UPLOAD_BYTES=536870912
MAX_IMAGE_UPLOAD_BYTES=10485760

# Cameras connected at the same time, across all production lines
MAX_CONNECTED_CAMERAS=8

# Request rate limit per client address on /api/ (HTTP 429 past it); 0 = off.
# One dashboard tab sends about 2 requests/s. Behind a reverse proxy, start
# uvicorn with FORWARDED_ALLOW_IPS=<proxy address> in its environment (or
# --forwarded-allow-ips) so each user gets their own limit; otherwise everyone
# behind the proxy shares one, and you should raise it or set it to 0.
RATE_LIMIT_PER_SECOND=50
RATE_LIMIT_BURST=200

# Health monitoring (seconds)
HEALTH_CHECK_INTERVAL_SECONDS=2.0
# No new camera frame for this long = camera stalled
HEALTH_CAMERA_STALE_SECONDS=5.0
# Frames arriving but none inferred for this long = inference stalled
HEALTH_INFERENCE_STALE_SECONDS=10.0

# Startup and reconnects (seconds)
# Startup waits this long for the saved cameras, MQTT broker and PLC checks, then
# serves the API while the rest keep connecting in the background
STARTUP_CONNECT_WAIT_SECONDS=15
# Cameras that could not be opened are retried, waiting up to this long between tries
CAMERA_RECONNECT_MAX_SECONDS=60
# Limits for opening a camera stream and for each frame read
CAMERA_OPEN_TIMEOUT_SECONDS=10
CAMERA_READ_TIMEOUT_SECONDS=5

# Production records (the Records page and its CSV / Excel exports)
# Days a product record is kept; older rows are deleted once an hour. 0 = for ever.
RECORDS_RETENTION_DAYS=90
# Rows that may wait to be written; past this the oldest are dropped (alarm records.dropped)
RECORDS_QUEUE_LIMIT=100000

# Logging (always to stdout; also to LOG_DIR/app.log when LOG_TO_FILE is true,
# rotated at LOG_FILE_MAX_BYTES with LOG_FILE_BACKUP_COUNT old files kept)
LOG_LEVEL=INFO
LOG_DIR=./logs
LOG_TO_FILE=true
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=5

# ─── Docker Compose (docker-compose.yml reads these; the app ignores them) ────
# Time zone for log timestamps, e.g. Europe/Berlin (default UTC)
TZ=UTC
# Host address and port for the API; 0.0.0.0 = every network card of the host
VISION_BIND_ADDRESS=0.0.0.0
VISION_HTTP_PORT=8000
# Memory ceiling for the container; past it the server is restarted.
# About 3/4 of the machine's RAM.
VISION_MEM_LIMIT=4g

# ─── Docker container supervisor (docker/supervise.py) ─────────────────────────
# Seconds uvicorn gives open requests and video streams on shutdown
GRACEFUL_SHUTDOWN_SECONDS=20
# Restart the container when /health fails WATCHDOG_FAILURES times in a row,
# checked every WATCHDOG_INTERVAL s once the server has started; 0 turns it off
WATCHDOG_ENABLED=1
# Seconds before the first check, and how long the server may take to start
# (open its port) before the container is restarted
WATCHDOG_START_PERIOD=10
WATCHDOG_STARTUP_TIMEOUT=300
WATCHDOG_INTERVAL=15
WATCHDOG_TIMEOUT=5
WATCHDOG_FAILURES=4
