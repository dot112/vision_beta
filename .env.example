# App
APP_NAME=Industrial Vision API
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=false
# Required: generate a unique random value with at least 32 characters.
SECRET_KEY=
# Required on first setup only: generate a random password of at least 20 characters.
ADMIN_INITIAL_PASSWORD=

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=1

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/factory_data.db

# Auth / JWT
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# MQTT
MQTT_BROKER_HOST=
MQTT_BROKER_PORT=8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS_ENABLED=true

# Modbus
MODBUS_HOST=192.168.1.100
MODBUS_PORT=502
MODBUS_TIMEOUT=3

# Model / Inference
MODEL_STORE_PATH=./model_store
INFERENCE_DEVICE=cpu
# CPU threads for ONNX Runtime; 0 = auto (2 with a GPU, about one per core on CPU)
INFERENCE_THREADS=0
INFERENCE_CONFIDENCE=0.5

# Logging
LOG_LEVEL=INFO
LOG_DIR=./logs
